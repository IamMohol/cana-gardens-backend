# ==============================================================================
# Cana Gardens - Laravel REST API Environment Configuration
# Target Host: https://api.canagardens.co.ke
# Document Root on Hostinger: /home/u585677773/domains/canagardens.co.ke/public_html/api-backend/public
# ==============================================================================

APP_NAME="Cana Gardens API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.canagardens.co.ke
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production MySQL Database on Hostinger
# Create database and user via Hostinger hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u585677773_canagardens
DB_USERNAME=u585677773_canauser
DB_PASSWORD=your_hostinger_database_password_here

# Session & Cache Drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://canagardens.co.ke,https://www.canagardens.co.ke,http://localhost:3000

# Mail Configuration (Defaults to log for safety; configure SMTP if desired)
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@canagardens.co.ke
MAIL_PASSWORD=your_email_account_password_here
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@canagardens.co.ke"
MAIL_FROM_NAME="Cana Gardens Inquiries"

# Notification recipient for inquiries
CONTACT_RECEIVER_EMAIL=info@canagardens.co.ke
